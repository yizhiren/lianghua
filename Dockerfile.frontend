FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY app ./app
COPY build ./build
COPY public ./public
COPY worker ./worker
COPY .openai ./.openai
COPY next.config.ts vite.config.ts tsconfig.json postcss.config.mjs eslint.config.mjs ./
ARG NEXT_PUBLIC_API_URL=http://127.0.0.1:8010/api
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN npm run build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/.openai ./.openai
EXPOSE 3001
CMD ["npm", "run", "start", "--", "--host", "0.0.0.0", "--port", "3001"]
