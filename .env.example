# Real public market data for Shanghai, Shenzhen and Hong Kong stocks.
MARKET_DATA_MODE=akshare
DATABASE_PATH=./data/lianghua.db
SCAN_INTERVAL_MINUTES=15
BACKFILL_BATCH_SIZE=100
MARKET_HISTORY_YEARS=15
MARKET_BACKFILL_RETRIES=3
BACKFILL_MAX_CONCURRENCY=3

# Optional OpenAI-compatible endpoint used for natural-language strategy drafts.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=60
AI_RETRY_ATTEMPTS=3
AI_RETRY_BACKOFF_SECONDS=1
BACKEND_LOG_PATH=.runtime/backend.log
TRADING_MODE=paper
BROKER_ADAPTER=paper
LIVE_TRADING_ENABLED=false
PAPER_CNY_CASH=1000000
PAPER_HKD_CASH=1000000
MAX_SECURITY_EXPOSURE_PCT=10
MAX_STRATEGY_EXPOSURE_PCT=30
DAILY_LOSS_PAUSE_PCT=2
TRAINING_SNAPSHOT_DIR=./data/training_snapshots
TRAINING_WEEKLY_BUDGET=200
TRAINING_SMOKE_BUDGET=12
TRAINING_MIN_YEARS=10
TRAINING_MAX_DRAWDOWN_PCT=15

NEXT_PUBLIC_API_URL=http://127.0.0.1:8010/api
